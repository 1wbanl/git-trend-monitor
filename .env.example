# ── Server ──────────────────────────────────────────────────────
PORT=8787
HOST=127.0.0.1
# DATA_DIR=./server/data

# ── GitHub data source (optional) ───────────────────────────────
# A token raises the GitHub REST API limit from 60 to 5,000 requests/hour.
GITHUB_TOKEN=

# ── Remote generation model (optional) ──────────────────────────
# Leave empty to use the built-in local RAG answer engine.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_PROVIDER_NAME=DeepSeek

# Any OpenAI-compatible endpoint also works, for example:
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ── Optional webhook delivery for alert rules ───────────────────
# Configured webhooks receive a JSON payload when a rule is triggered.
ALERT_WEBHOOK_URL=
